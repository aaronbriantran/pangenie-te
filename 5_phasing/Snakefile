SAMPLES = ["some list of strings", "here's another string!"]
INPUT_DIR = "some/string/for/paths/to/vcf/for/example..."

rule all:
   input:
      "a phased VCF that is combined across samples"

rule index_vcfs:
   input:
      "{INPUT_DIR}/{sample}.vcf"
   output:
      gz = "results/index_vcfs/{sample}.vcf.gz"
      csi = "results/index_vcfs/{sample}.vcf.gz.csi"
   log:
      "logs"
   threads: 9999
   resources:
      runtime=9999
      mem_mb=9999
   shell:
      """
      bgzip -c --threads {threads} {input} > {output.gz} 2> {log}
      bcftools index --threads {threads} {output.gz} > {output.csi} 2>> {log}
      """ #WARNING: need to ml samtools/1.18!

rule combine_vcfs:
   input:
      expand("results/index_vcfs/{sample}.vcf.gz", sample=SAMPLES)
      expand("results/index_vcfs/{sample}.vcf.gz.csi", sample=SAMPLES)
   output:
      bcf = "results/combine_vcfs/combined.bcf", #turn a bunch of vcfs into a combined bcf
      csi = "results/combine_vcfs/combined.bcf.csi"
   log:
      "logs"
   threads: 9999
   resources:
      runtime=9999
      mem_mb=9999
   shell:
      # -m none for no multiallelics, -W write csi index
      """
      bcftools merge --threads {threads} \
      -m none \
      -W \
      -o {output.bcf} {input.gz} 2> {log}
      """

checkpoint 

rule split_for_common_phasing:
   input:
      "combined.bcf"
   output:
      expand(a bunch of chunks, CHUNK=number, CHR=another number) #generate chunks using bedtools and iterating
   log:
      "logs"
   threads: 9999
   resources:
      runtime=9999
      mem_mb=9999
   shell:
      """
      use bedtools makewindows to create overlapping windows
      while loop over each line of the bedtools output:
         phase_common --input array/target.family.bcf --pedigree info/target.family.fam --region 1 --map info/chr1.gmap.gz --output target.phased.bcf --thread 8
         outputs should be sortable by ls -1v
      """

rule common_variant_ligation:
   input:
      expand(a bunch of phased chunks, make sure to name them differently, use the WILDCARD of chromosome here to do the merging per chromosome, CHUNK=num) #make sure to sort the input when you get it!
   output:
      "ligated{chr}.bcf, for example" #make sure to use --pedigree!
   log:
      "log"
   threads: 9999
   resources:
      runtime=9999
      mem_mb=9999
   shell:
      """
      ls -1v tmp/target.scaffold.chunk*.bcf > tmp/files.txt
      ligate --input tmp/files.txt --output tmp/target.scaffold.bcf --thread 8 --index
      """