SAMPLES = ["some list of strings", "here's another string!"]
INPUT_DIR = "some/string/for/paths/to/vcf/for/example..."

rule all:
   input:
      "a phased VCF that is combined across samples"

rule index_vcfs:
   input:
      "{INPUT_DIR}/{sample}.vcf"
   output:
      gz = "results/index_vcfs/{sample}.vcf.gz"
      csi = "results/index_vcfs/{sample}.vcf.gz.csi"
   log:
      "logs/index_vcfs.log"
   threads: 9999
   resources:
      runtime=9999
      mem_mb=9999
   shell:
      """
      bgzip -c --threads {threads} {input} > {output.gz} 2> {log}
      bcftools index --threads {threads} {output.gz} > {output.csi} 2>> {log}
      """ #WARNING: need to ml samtools/1.18!

rule combine_vcfs:
   input:
      expand("results/index_vcfs/{sample}.vcf.gz", sample=SAMPLES)
      expand("results/index_vcfs/{sample}.vcf.gz.csi", sample=SAMPLES)
   output:
      bcf = "results/combine_vcfs/combined.bcf", #turn a bunch of vcfs into a combined bcf
      csi = "results/combine_vcfs/combined.bcf.csi"
   log:
      "logs/combine_vcfs.log"
   threads: 9999
   resources:
      runtime=9999
      mem_mb=9999
   shell:
      # -m none for no multiallelics, -W write csi index
      """
      bcftools merge --threads {threads} \
      -m none \
      -W \
      -o {output.bcf} {input.gz} 2> {log}
      """

rule split_and_common_phasing:
   input:
      "results/combine_vcfs/combined.bcf"
   output:
      "results/split_and_common_phasing/combined_chr{chr}_{begin}_{end}.bcf"
   log:
      "logs/split_and_common_phasing.log"
   threads: 9999
   resources:
      runtime=9999
      mem_mb=9999
   shell: #want input directives or known variables for haplotype reference, genetic map, and pedigree file?
      """
      phase_common \
         --input {input} \
         --region {chr} \
         --reference ???? \
         --map "inputs/chr{chr}.gmap.gz" \
         --pedigree ???? \
         --output {output} \
         --threads {threads} 2> {log}
      """

#expects a wildcards argument (required by Snakemake) and a string that describes the file location of the bedtools makewindows output
#runs through the output line by line and converts "chr1 10 20" to "chr1_10_20"
#adds the sample wildcard to manage the aggregation and prevent aggregation between samples, etc.
#returns a list of all of these values
#as an input function, this should occur at DAG time
def get_bedtools_windows(wildcards, bedtools_file):
   windows_list = []
   file = open(bedtools_file, "r")
   for line in file:
      input_file = os.path.join(FILE_PATH, "combined_" + "_".join(line.strip().split(" "))) #os.path.join? how to correctly combine pathnames and strings?
      windows_list.append()
   file.close()
   return windows_list

#request chunks for all windows from split_and_common_phasing
#aggregate the names of those chunk files as a string and convert to a nice list
#???? NEEDS TO HAPPEN PER CHROMOSOME! SO YOU'LL NEED TO SPLIT SAMPLES AND WHATNOT
rule common_variant_ligation:
   input:
      get_bedtools_windows(wildcards, COMMON_WINDOWS_FILE)
   output:
      "ligated{chrnumber}.bcf, for example" #make sure to use --pedigree!
   log:
      "log"
   threads: 9999
   resources:
      runtime=9999
      mem_mb=9999
   shell:
      """
      echo "{input}" | sed 's/ /\n/g' | sort -t "_" -k1,1 -k2,2n > tmp/common_phase_chunks.txt

      ligate \
         --input tmp/common_phase_chunks.txt \
         --output ligated{chr}.bcf \
         --thread 8 \
         --index \
         --pedigree
      """

