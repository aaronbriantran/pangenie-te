def parse_coords(wildcards, chk, filepath):
   coordlist=[]
   with chk.get(chr=wildcards.chr).output[0].open() as f:
      for line in f:
         line_arr = line.strip().split(" ")
         coordlist.append(line_arr[-1]) #what does the output of GLIMPSE look like...????
   return coordlist

def parse_common_coords(wildcards):
   return parse_coords(wildcards, chk=checkpoints.create_common_chunks)

def parse_rare_coords(wildcards):
   return parse_coords(wildcards, chk=checkpoints.create_rare_chunks)

rule ligate_common_chunks:
   input:
      chunks=expand("results/phase_common/{chr}/{coords}_common.bcf", coords=parse_common_coords(wildcards), allow_missing=True)
      pedigree="????"
   output:
      "results/ligate_common_chunks/ligated_{chr}.bcf"
   log:
      "log/ligate_common_chunks.log"
   threads: 9999
   resources:
      runtime=9999
      mem_mb=9999
   shell:
      """
         echo "{input.chunks}" | sed 's/ /\n/g' | sort -t "_" -k1,1 -k2,2n > results/ligate_common_chunks/common_phase_chunks_{chr}.txt

         ????/ligate \
         --input results/ligate_common_chunks/common_phase_chunks_{chr}.txt \
         --output {output} \
         --pedigree {input.pedgree} \
         --thread {threads} \
         --log {log}

         cat results/ligate_common_chunks/common_phase_chunks_{chr}.txt >> {log}
      """

