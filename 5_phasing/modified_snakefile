"""
 merge VCFs into a singular VCF
 split VCF by chrs
 for each CHR, split into common chunks
 phase each chunk
 ligate chunks together and create a CHR scaffold
 create rare chunks
 phase directly onto scaffold
 sort and bcftools concat
 """

SAMPLES=["F1", "F2", "M1"]

rule all:
   input:
      "results/phased_complete.bcf"

rule index_vcfs:
   input: 
      "3_pangenie/something????/{sample}.vcf"
   output:
      gz = "results/index_vcfs/{sample}.vcf.gz"
      csi = "results/index_vcfs/{sample}.vcf.gz.csi"
   log:
      "logs/index_vcfs.log"
   threads: 9999
   resources:
      runtime=9999
      mem_mb=9999
   shell:
      """
      ml samtools/1.18
      ml bcftools/
      bgzip -c --threads {threads} {input} > {output.gz} 2> {log}
      bcftools index --threads {threads} {output.gz} > {output.csi} 2>> {log}
      """

rule combine_vcfs:
   input:
      gz = expand("results/index_vcfs/{sample}.vcf.gz", sample=SAMPLES)
      csi = expand("results/index_vcfs/{sample}.vcf.gz.csi", sample=SAMPLES)
   output:
      bcf = "results/combine_vcfs/combined.bcf", #turn a bunch of vcfs into a combined bcf
      csi = "results/combine_vcfs/combined.bcf.csi"
   log:
      "logs/combine_vcfs.log"
   threads: 9999
   resources:
      runtime=9999
      mem_mb=9999
   shell:
      # -m none for no multiallelics, -W write csi index
      """
      ml samtools/1.18
      bcftools merge --threads {threads} \
      -m none \
      -W \
      -o {output.bcf} {input.gz} 2> {log}
      """

checkpoint create_common_chunks:
   input:
      panel="inputs/pangenie.vcf????"
      map_file="inputs/maps/chr{chr}.gmap.gz"
   output:
      "results/create_common_chunks/common_chunks_chr{chr}.txt"
   log:
      "logs/create_common_chunks.log"
   threads: 9999
   resources:
      runtime=9999
      mem_mb=9999
   shell:
      #window refers to the size of the chunk. SHAPEIT says it's good practice to do 20 cM
      #buffer refers to the size of overlaps between chunks. SHAPEIT thinks 2 Mb, about 2 cM is good
      #sequential is recommended by GLIMPSE
      """
         ????/GLIMPSE2_chunk \
            --input {input.panel} \
            --map {input.map_file} \
            --region chr{chr} \
            --sequential \
            --window-cm 20 \
            --buffer-cm 2 \
            --output {output} \
            --log {log} \
            --threads {threads}
      """

